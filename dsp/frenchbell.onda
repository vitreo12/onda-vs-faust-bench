# Process the modes in groups of eight, with a separate unforced decay path.
# pm.frenchBell_ui of Faust's physmodels.lib (examples/physicalModeling/frenchBell.dsp) ported
# to Onda, gate held at 1 like frenchbell.dsp: the bell is struck once. Strike (pm.strikeModel):
# noise through a 10 Hz highpass and a lowpass at strikeCutOff (TPT state variable filters),
# shaped by a triangular attack-release envelope (en.ar). Bell (pm.frenchBellModel): 50 modes
# (pm.modeFilter, Chamberlin form) in parallel, averaged.
# Expert variant: the mode sum split into 4 interleaved partial sums, as ocpp does.

params:
  strikePosition = 0 {0, 6}
  strikeCutOff = 6500.0 {20.0, 20000.0}
  strikeSharpness = 0.5 {0.01, 5.0}
  gain = 1.0 {0.0, 1.0}
  gate = 1.0 {0.0, 1.0}

const MODES = 50
const BIG = 340282350000000000000000000000000000000.0  # ma.MAX

const FREQS: f64[50] = [
  439.077, 440.305, 606.452, 611.776, 709.617, 709.877, 856.966, 899.051, 1064.37, 1064.75, 1073.03,
  1074.43, 1076.58, 1145.42, 1148.9, 1197.09, 1199.91, 1387.7, 1400.16, 1402.37, 1512.06, 1513.06,
  1592.47, 1593.35, 1663.45, 1666.47, 1691.32, 1693.77, 1804.83, 1808.84, 1820.07, 1847.14, 1910.73,
  1927.7, 2035.07, 2038.73, 2054.66, 2055.67, 2078.69, 2091.76, 2115.78, 2127.01, 2209.86, 2214.05,
  2296.15, 2298.08, 2298.97, 2307.62, 2404.44, 2408.99
]

# modesGains of pm.frenchBellModel: 7 strike positions x 50 modes
const GAINS: f32[350] = [
  0.97289, 0.542393, 0.495832, 0.897966, 0.552367, 0.557895, 0.614213, 0.353694, 0.436039, 0.441024,
  0.674913, 0.566754, 0.755008, 0.69903, 0.164398, 0.91004, 0.628373, 0.201718, 0.429517, 0.503715,
  0.871174, 0.106886, 0.761173, 0.673602, 0.291937, 0.58859, 0.31528, 0.413081, 0.274464, 0.494062,
  0.696121, 0.61201, 0.382757, 0.995113, 0.228806, 0.198449, 0.595847, 0.306263, 0.252397,
  0.0883567, 0.236086, 1.0, 0.245278, 0.379388, 0.198824, 0.548892, 0.492764, 0.420871, 0.794637,
  0.605634, 1.0, 0.604159, 0.399841, 0.799347, 0.507187, 0.50981, 0.477383, 0.310226, 0.426976,
  0.437623, 0.735712, 0.630728, 0.625785, 0.651168, 0.277738, 0.850858, 0.578079, 0.645354, 0.3837,
  0.370598, 0.782542, 0.181325, 0.614391, 0.740684, 0.342441, 0.586186, 0.286909, 0.405197,
  0.259215, 0.566983, 0.748219, 0.655898, 0.36826, 0.940814, 0.336157, 0.413702, 0.561557, 0.402176,
  0.117698, 0.329369, 0.254571, 0.870706, 0.260981, 0.274122, 0.206247, 0.6453, 0.400758, 0.363622,
  0.636834, 0.584566, 0.975603, 0.616937, 0.295401, 0.650447, 0.464221, 0.465057, 0.312467,
  0.238358, 0.383695, 0.399674, 0.753912, 0.662012, 0.504268, 0.599248, 0.378665, 0.725363,
  0.493214, 1.0, 0.332836, 0.265889, 0.674073, 0.320401, 0.440018, 0.769782, 0.316419, 0.529968,
  0.380509, 0.578676, 0.249013, 0.591384, 0.761717, 0.687057, 0.324437, 0.818864, 0.505369,
  0.672485, 0.461783, 0.426198, 0.0678875, 0.435329, 0.347955, 0.708394, 0.293322, 0.328986,
  0.258254, 0.893512, 0.320131, 0.433554, 0.459302, 0.542213, 0.817241, 0.51623, 0.205302, 0.467354,
  0.388683, 0.388216, 0.171262, 0.150865, 0.29172, 0.311414, 0.658876, 0.570647, 0.383619, 0.502455,
  0.364114, 0.532313, 0.352989, 1.0, 0.261984, 0.219591, 0.544031, 0.337199, 0.279173, 0.668303,
  0.208439, 0.39923, 0.418674, 0.648618, 0.234133, 0.504729, 0.645347, 0.572851, 0.232828, 0.614292,
  0.485272, 0.666264, 0.31657, 0.320355, 0.191421, 0.340131, 0.342069, 0.538371, 0.281131, 0.393115,
  0.251394, 0.890725, 0.310644, 0.5037, 0.29909, 0.442478, 0.733128, 0.455217, 0.199322, 0.315699,
  0.375856, 0.37649, 0.029145, 0.0200283, 0.279578, 0.3168, 0.655957, 0.546843, 0.349666, 0.470249,
  0.353765, 0.286794, 0.180185, 1.0, 0.210831, 0.280133, 0.535853, 0.376488, 0.15367, 0.634745,
  0.0510449, 0.485575, 0.593111, 0.917884, 0.380477, 0.422925, 0.599373, 0.311421, 0.135654,
  0.359954, 0.295748, 0.474439, 0.353339, 0.116743, 0.454313, 0.112858, 0.35931, 0.483897, 0.301608,
  0.577342, 0.262663, 0.794986, 0.54958, 0.808086, 0.152511, 0.439591, 0.535941, 0.308018, 0.419837,
  0.579191, 0.250428, 0.25212, 0.10286, 0.288332, 0.599679, 0.665108, 0.636285, 0.495234, 0.251613,
  0.208527, 0.0939072, 0.458415, 0.318952, 0.23535, 0.215189, 0.313412, 0.0472787, 0.0386893,
  0.0863359, 0.222346, 0.361511, 0.997037, 0.238509, 0.38214, 1.0, 0.203554, 0.472087, 0.509015,
  0.206371, 0.441013, 0.794008, 0.971623, 0.796384, 0.55043, 0.68778, 0.554298, 0.0436545,
  0.0595577, 0.214685, 0.58147, 0.27732, 0.368466, 0.121382, 0.152739, 0.0782244, 0.190497,
  0.316269, 0.180456, 0.405196, 0.518716, 0.159365, 0.165808, 0.194372, 0.614764, 0.553415,
  0.644794, 0.44178, 0.44149, 0.221588, 1.0, 0.579371, 0.606339, 0.529167, 0.0214475, 0.417046,
  0.663152, 0.894841, 0.475752, 0.168289, 0.46859, 0.304604, 0.666369, 0.308337, 0.295091, 0.768945,
  0.350911, 0.49068, 0.516584, 0.400117, 0.820687, 0.545486, 0.709357, 0.509759, 0.472006, 0.152455,
  0.981265, 0.459134, 0.698666, 0.247154, 0.623253, 0.255508, 0.830815, 0.088709, 0.126082,
  0.0770623, 0.263328
]

# the parts of pm.modeFilter's coefficients that depend only on the mode: 0.5*ln(1000)/t60
# (t60 = 30*(1 - f/2555.3)^3) and pi*f, both later divided by the sample rate
const def mode_decay() -> f32[50]:
  u: f32[50]
  for i in 0..MODES:
    t60: f64 = 30.0 * pow(1.0 - FREQS[i] / 2555.3, 3.0)
    u[i] = f32(0.5 * log(1000.0) / t60)
  return u

const def mode_angle() -> f32[50]:
  w: f32[50]
  for i in 0..MODES:
    w[i] = f32(PI * FREQS[i])
  return w

const DECAY: f32[50] = mode_decay()
const ANGLE: f32[50] = mode_angle()

const Lanes = 8
const Padded = (MODES + Lanes - 1) / Lanes * Lanes

init:
  # pm.modeFilter coefficients per mode
  f2: f32[Padded]  # Chamberlin f^2
  damping: f32[Padded]  # Band state coefficient after folding the damping term.
  op: f32[Padded]  # (1 + t)^2
  b0: f32[Padded]  # |1 - p|^2 (1 + t)^2 / 4
  for i in 0..MODES:
    t = tanh(DECAY[i] / SR)
    t2 = t * t
    s = sin(ANGLE[i] / SR)
    b0[i] = t2 + s * s * (1.0 - t2)
    op[i] = (t + 1.0) * (t + 1.0)
    f2[i] = min(4.0 * (b0[i] / op[i]), BIG)
    damping[i] = 1.0 - f2[i] * (min(t / b0[i], BIG) + 1.0)
  low: f32[Padded]  # mode states: lowpass / f ...
  band: f32[Padded]  # ... and bandpass
  seed: i32 = 0  # no.noise
  h1 = 0.0  # 10 Hz highpass (fi.highpass(2, 10))
  h2 = 0.0
  l1 = 0.0  # lowpass at strikeCutOff (fi.lowpass(2, .))
  l2 = 0.0
  gatePrev = 0.0
  count = 0  # en.ar: samples since the strike
  xp = 0.0  # previous strike sample (the modes take x + x')
  gh = tan(max(0.0, min(PI * 10.0 / SR, 1.5676547)))
  ghk = gh + 1.4142135
  gh9 = -1.4142135 - gh
  ch = gh * min(BIG, 1.0 / (gh * ghk + 1.0))

block:
  p = MODES * strikePosition
  gi: f32[Padded]  # input gain per mode, referred to 44.1 kHz
  for i in 0..MODES:
    gi[i] = f2[i] * min(11025.0 / SR * (op[i] * GAINS[p + i] / b0[i]), BIG)
  gl = tan(max(0.0, min(PI / SR * strikeCutOff, 1.5676547)))
  glk = gl + 1.4142135
  cl = gl * min(BIG, 1.0 / (gl * glk + 1.0))
  invAtt = 1.0 / max(1.0, 0.002 * SR * strikeSharpness)
  sample:
    # strike: noise -> highpass -> lowpass, times the attack-release envelope
    seed = 12345 + 1103515245 * seed
    n = 0.0000000004656613 * f32(seed)
    t1 = n - (ghk * h1 + h2)
    v1 = h1 + ch * t1
    hp = n + gh9 * v1 - h2
    h1 += 2.0 * ch * t1
    h2 += 2.0 * gh * v1
    t3 = hp - (glk * l1 + l2)
    w1 = l1 + cl * t3
    lp = l2 + gl * w1
    l1 += 2.0 * cl * t3
    l2 += 2.0 * gl * w1
    rise = 0
    if gate > gatePrev:
      rise = 1
    keep = 0
    if gate <= gatePrev:
      keep = 1
    if count > 0:
      count = rise + (count + 1) * keep
    else:
      count = rise + count * keep
    gatePrev = gate
    tt = invAtt * f32(count)
    x = gain * lp * max(0.0, min(tt, 2.0 - tt))
    xin = x + xp
    xp = x
    sums: f32[Lanes]
    if xin == 0.0:
      for group in 0..Padded / Lanes:
        for lane in 0..Lanes:
          i = group * Lanes + lane
          l = low[i] + band[i]
          band[i] = fma(damping[i], band[i], -f2[i] * low[i])
          low[i] = l
          sums[lane] += band[i]
    else:
      for group in 0..Padded / Lanes:
        for lane in 0..Lanes:
          i = group * Lanes + lane
          l = low[i] + band[i]
          input = fma(-f2[i], low[i], gi[i] * xin)
          band[i] = fma(damping[i], band[i], input)
          low[i] = l
          sums[lane] += band[i]
    total = sums[0]
    for lane in 1..Lanes:
      total += sums[lane]
    out = 0.02 * total
    out1 = out
    out2 = out
