# Opposite speakers share the even harmonics and reverse the odd ones.

sample:
  mid = 0.125 * in1
  even_x = 0.176776695 * in4
  even_y = 0.176776695 * in5

  first_x = 0.230969883 * in2
  first_y = 0.230969883 * in3
  third_x = 0.095670858 * in6
  third_y = 0.095670858 * in7
  axis0 = first_x + third_x
  axis2 = first_y - third_y
  diagonal_x = (first_x - third_x) * 0.707106781
  diagonal_y = (first_y + third_y) * 0.707106781
  axis1 = diagonal_x + diagonal_y
  axis3 = diagonal_y - diagonal_x

  even0 = mid + even_x
  even1 = mid + even_y
  even2 = mid - even_x
  even3 = mid - even_y
  out1 = even0 + axis0
  out2 = even1 + axis1
  out3 = even2 + axis2
  out4 = even3 + axis3
  out5 = even0 - axis0
  out6 = even1 - axis1
  out7 = even2 - axis2
  out8 = even3 - axis3
