# Store each input’s contributions to future outputs in the transposed FIR form.

const TapCount = 32

const def make_taps() -> f32[TapCount]:
  taps: f32[TapCount]
  for i in 0..TapCount:
    taps[i] = sin(0.3 * f32(i + 1)) / f32(i + 1)
  return taps

const Taps = make_taps()

init:
  pending: f32[TapCount - 1]

sample:
  x = in1
  out1 = fma(Taps[0], x, pending[0])
  for i in 0..TapCount - 2:
    pending[i] = fma(Taps[i + 1], x, pending[i + 1])
  pending[TapCount - 2] = Taps[TapCount - 1] * x
