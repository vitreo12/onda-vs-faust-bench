ins 1

params:
  base = 800.0 {50.0, 5000.0}
  depth = 2.0 {0.0, 4.0}
  rate = 0.5 {0.01, 20.0}
  q = 2.0 {0.5, 20.0}

init:
  position = 0.0
  ic1 = 0.0
  ic2 = 0.0

block:
  increment = rate / SR
  k = 1.0 / q
  angle_base = PI * base / SR
  sample:
    position += increment
    if SR >= 40:
      if position >= 1.0:
        position -= 1.0
    else:
      position -= floor(position)
    lfo = sin(TWO_PI * position)
    g = tan(angle_base * pow(2.0, depth * lfo))
    a1 = 1.0 / fma(g, g + k, 1.0)
    a2 = g * a1
    a3 = g * a2
    v3 = in1 - ic2
    v1 = fma(a1, ic1, a2 * v3)
    v2 = fma(a2, ic1, fma(a3, v3, ic2))
    ic1 = 2.0 * v1 - ic1
    ic2 = 2.0 * v2 - ic2
    out1 = v2
