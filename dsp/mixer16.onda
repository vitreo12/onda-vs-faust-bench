# 16-channel mixer: dB gain and constant-power pan per channel, master gain,
# Compute control-rate coefficients once per block and group the audio inputs by name.

ins:
  channels: f32[16]

params:
  gain: f32[16] = -6.0 {-60.0, 12.0}
  pan: f32[16] = [0.000000000, 0.066666667, 0.133333333, 0.200000000, 0.266666667, 0.333333333, 0.400000000, 0.466666667, 0.533333333, 0.600000000, 0.666666667, 0.733333333, 0.800000000, 0.866666667, 0.933333333, 1.000000000] {0.0, 1.0}
  master = -3.0 {-60.0, 12.0}

block:
  m = pow(10.0, master / 20.0)
  gl: f32[16]
  gr: f32[16]
  for i in 0..16:
    g = pow(10.0, gain[i] / 20.0) * m
    gl[i] = g * cos(pan[i] * PI * 0.5)
    gr[i] = g * sin(pan[i] * PI * 0.5)
  sample:
    l = 0.0
    r = 0.0
    for i in 0..16:
      l += channels[i] * gl[i]
      r += channels[i] * gr[i]
    out1 = l
    out2 = r
