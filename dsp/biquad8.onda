# Compute delayed terms independently of the cascade’s current input.

params:
  cutoff = 1000.0 {20.0, 20000.0}
  q = 0.707 {0.1, 10.0}

init:
  w1: f32[8]
  w2: f32[8]

block:
  w0 = TWO_PI * cutoff / SR
  alpha = sin(w0) / (2.0 * q)
  cw = cos(w0)
  a0 = 1.0 + alpha
  b0 = (1.0 - cw) * 0.5 / a0
  b1 = (1.0 - cw) / a0
  b2 = b0
  feedback1 = 2.0 * cw / a0
  feedback2 = -(1.0 - alpha) / a0
  sample:
    x = in1
    for i in 0..8:
      past1 = w1[i]
      past2 = w2[i]
      feed = fma(b1, past1, b2 * past2)
      w = x + (fma(feedback1, past1, feedback2 * past2))
      x = fma(b0, w, feed)
      w2[i] = w1[i]
      w1[i] = w
    out1 = x
