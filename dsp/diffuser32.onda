# Factor the direct signal path of each allpass and express the fused operation.

const Delays: i32[32] = [
  113, 127, 137, 149, 157, 173, 191, 211, 223, 239, 263, 283, 307, 337, 367, 397, 431, 467, 509,
  557, 599, 653, 709, 769, 839, 911, 991, 1087, 1171, 1277, 1381, 1499
]

namespace Allpass<Length = 2>:
  struct Stage:
    history: f32[Length]
    cursor: i32 {Length, wrap}

    def tick(self, signal: f32, gain: f32):
      delayed = self.history[self.cursor]
      stored = fma(-gain, delayed, signal)
      self.history[self.cursor] = stored
      self.cursor += 1
      return fma(gain, signal, (1.0 - gain * gain) * delayed)

namespace Section<First = 0>:
  struct Stages:
    a: Allpass<Delays[First]>::Stage
    b: Allpass<Delays[First + 1]>::Stage
    c: Allpass<Delays[First + 2]>::Stage
    d: Allpass<Delays[First + 3]>::Stage

    def tick(self, signal: f32):
      a = self.a.tick(signal, 0.6)
      b = self.b.tick(a, -0.6)
      c = self.c.tick(b, 0.6)
      return self.d.tick(c, -0.6)

init:
  section0 = Section<0>::Stages()
  section1 = Section<4>::Stages()
  section2 = Section<8>::Stages()
  section3 = Section<12>::Stages()
  section4 = Section<16>::Stages()
  section5 = Section<20>::Stages()
  section6 = Section<24>::Stages()
  section7 = Section<28>::Stages()

sample:
  signal = in1
  signal = section0.tick(signal)
  signal = section1.tick(signal)
  signal = section2.tick(signal)
  signal = section3.tick(signal)
  signal = section4.tick(signal)
  signal = section5.tick(signal)
  signal = section6.tick(signal)
  signal = section7.tick(signal)
  out1 = signal
