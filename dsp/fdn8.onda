const Lines = 8
const Capacity = 2048

# The feedback loop contributes the remaining one-sample delay.
const DelaySamples: i32[Lines] = [1008, 1150, 1278, 1380, 1498, 1606, 1732, 1860]

namespace Butterfly<Half = 1>:
  def mix(values: f32[Lines]):
    for group in 0..Lines / (2 * Half):
      for j in 0..Half:
        i = group * (2 * Half) + j
        a = values[i]
        b = values[i + Half]
        values[i] = a + b
        values[i + Half] = a - b

params:
  g = 0.9 {0.0, 0.999}
  damp = 0.3 {0.0, 0.99}

init:
  # Each row holds the samples arriving together. Writes select a future row
  # using each line's delay, and reads take one contiguous row.
  history: f32[Lines * Capacity]
  cursor = 0 {Capacity, wrap}
  delayed: f32[Lines]
  lowpass: f32[Lines]

block:
  gain = g / sqrt(f32(Lines))
  feed = 1.0 - damp

  sample:
    mixed: f32[Lines]
    for i in 0..Lines:
      lowpass[i] = fma(feed, delayed[i], damp * lowpass[i])
      mixed[i] = lowpass[i]

    # The three butterfly stages implement the eight-line Hadamard mix.
    Butterfly<1>::mix(mixed)
    Butterfly<2>::mix(mixed)
    Butterfly<4>::mix(mixed)

    excitation = in1
    frame = cursor * Lines
    for i in 0..Lines:
      delayed[i] = history[frame + i]
    for i in 0..Lines:
      write = (cursor + DelaySamples[i]) {Capacity, wrap}
      history[write * Lines + i] = fma(mixed[i], gain, excitation)
    cursor += 1
    a = (delayed[0] + delayed[1]) + (delayed[2] + delayed[3])
    b = (delayed[4] + delayed[5]) + (delayed[6] + delayed[7])
    out1 = 0.25 * (a + b)
